				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>text=$(cat)
if [ -z "$text" ]; then exit 0; fi
encoded=$(/usr/bin/osascript -l JavaScript -e 'function run(argv) { return encodeURIComponent(argv[0]) }' "$text")
/usr/bin/open "dreamlingua://translate?text=$encoded"</string>
